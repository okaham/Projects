# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit it.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low = fastest/cheapest replies. medium/high = more thinking, slower texts.
CLAUDE_EFFORT=low

# --- BlueBubbles ---
# BlueBubbles runs on the same Mac, default port 1234.
BLUEBUBBLES_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=your-bluebubbles-server-password
# "apple-script" works with no extra setup. "private-api" needs the BlueBubbles Private API helper.
BLUEBUBBLES_SEND_METHOD=apple-script

# --- Security ---
# Comma-separated. Phone numbers in any format (+1 555-123-4567 is fine) and/or Apple ID emails.
# The FIRST one is where scheduled texts (morning summary) are sent - put your phone number first.
ALLOWED_SENDERS=+15551234567
# Random string. Must match the ?secret=... you put in the BlueBubbles webhook URL.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
WEBHOOK_SECRET=change-me

# --- Logging ---
LOG_FILE=logs/assistant.log

# --- Memory (Phase 2) ---
# false = every text is answered on its own (Phase 1 behavior). Test Phase 1 first, then set to true.
MEMORY_ENABLED=false
# How many past messages (yours + the bot's) Claude sees as context.
HISTORY_LIMIT=20
DB_PATH=data/assistant.db

# --- Google (Phase 4) ---
# Turn on after following docs/google-cloud-setup.md and running: python -m scripts.google_login
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_SECRET_FILE=secrets/google_client_secret.json
GOOGLE_TOKEN_FILE=secrets/google_token.json

# --- Scheduled morning summary (Phase 5) ---
# 24-hour time, e.g. 07:30. Leave empty to turn off. Needs GOOGLE_CALENDAR_ENABLED=true.
# After changing it, run: python -m scripts.service install
MORNING_SUMMARY_TIME=
